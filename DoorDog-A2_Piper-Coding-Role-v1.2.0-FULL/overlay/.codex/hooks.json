{
  "description": "DoorDog v1.2 coordination-state hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .ai/scripts/codex_team_hook.py pre",
            "timeout": 10,
            "statusMessage": "Validating team task contract"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(spawn_agent|send_message|followup_task|interrupt_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .ai/scripts/codex_team_hook.py post",
            "timeout": 10,
            "statusMessage": "Recording team coordination state"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .ai/scripts/codex_team_hook.py session-start",
            "timeout": 10,
            "statusMessage": "Loading pending run events"
          }
        ]
      }
    ]
  }
}

"""Pitch-aware dynamic reachability probe for A2_Piper base v15 (M23).

The pure grid/evidence/report functions intentionally import no IsaacLab, Isaac
Sim, Hydra, or Torch modules.  Runtime imports are delayed until the explicit
``--batch`` path so ``--help`` and focused tests remain CPU-only.

M23 is a dynamic command-space probe, not a placement map.  The robot starts at
the DoorPregrasp/A2_Base environment's configured initial state and is moved by
the explicit 12-D high-level command route (base 5 + arm 6 + gripper primitive 1).
The base legs remain controlled by the frozen A2_Base policy, while the six arm
commands come from a deterministic DifferentialIKController DLS target.  Pitch is
represented in the physical command space and converted to the raw action by
``physical / 0.4``.  No learned high-level policy action or per-cell body placement is used.
"""

from __future__ import annotations

import argparse
import csv
import json
from contextlib import contextmanager
import math
import os
import shutil
import subprocess
import sys
import tempfile
import traceback
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Any, Iterable, Sequence


REPO_ROOT = Path(__file__).resolve().parents[3]
DEFAULT_CHECKPOINT = (
    REPO_ROOT
    / "logs_rl/a2_piper_full_stage_a2_base/base_v14_main-20260719_103629/model_step_002000.pt"
)
DEFAULT_OUTPUT_STEM = "a2_piper_v15_dynamic_reachability"

PITCH_PHYSICAL_RAD = (0.0, 0.20, 0.40)
PITCH_RAW = tuple(round(value / 0.40, 10) for value in PITCH_PHYSICAL_RAD)
STANDOFFS_M = tuple(round(0.45 + 0.05 * index, 2) for index in range(9))
HANDLE_HEIGHTS_M = (0.95, 1.00, 1.05, 1.10)
ANCHOR_STANDOFFS_M = (0.5973835, 0.5981750, 0.5718842)
ANCHOR_HANDLE_HEIGHTS_M = (0.95, 1.00, 1.05)
EXPECTED_GRID_CELLS = len(PITCH_PHYSICAL_RAD) * len(STANDOFFS_M) * len(HANDLE_HEIGHTS_M)
EXPECTED_ANCHORS = len(ANCHOR_HANDLE_HEIGHTS_M)
PITCH_SCALE_RAD = 0.40
PITCH_TOLERANCE_RAD = 1.0e-4
HANDLE_HEIGHT_TOLERANCE_M = 5.0e-5
STANDOFF_COMMAND_TOLERANCE_M = 0.02
TCP_ERROR_TOLERANCE_M = 0.03
JOINT_MARGIN_THRESHOLD_RAD = 0.10
DIK_JOINT_LIMIT_MARGIN_RAD = 1.0e-4
DIK_SOFT_PROGRESS_TOLERANCE = 1.0e-6
DIK_JACOBIAN_CONDITION_MAX = 1.0e6
DIK_DIAGNOSTIC_MAX_ENV_RECORDS = 16
ARM_RAW_ACTION_ABS_MAX = 10.0
DELTA_ACTION_CLIP = 15.0
COMMAND_CONVERGENCE_STEPS = 1
M24_APPROVED_STANDOFF_MIN_M = 0.50
M24_APPROVED_STANDOFF_MAX_M = 0.80
M24_APPROVED_STANDOFF_INDICES = tuple(
    index
    for index, value in enumerate(STANDOFFS_M)
    if M24_APPROVED_STANDOFF_MIN_M <= value <= M24_APPROVED_STANDOFF_MAX_M
)
M24_APPROVED_STANDOFFS_M = tuple(STANDOFFS_M[index] for index in M24_APPROVED_STANDOFF_INDICES)
M24_HEIGHT_CAP_ALLOWED_M = 1.10
M24_HEIGHT_CAP_FALLBACK_M = 1.05
BASE_HEIGHT_MIN_M = 0.30
BASE_TILT_MAX_RAD = 0.90
BASE_LINEAR_SPEED_MAX_MPS = 1.50
BASE_ANGULAR_SPEED_MAX_RADPS = 2.50
M23_BASE_VX_MAX_MPS = 0.30
M23_STANDOFF_VELOCITY_GAIN = 2.0
M23_SELF_COLLISION_SENSOR_KEY_PREFIX = "a2_m23_self_collision_"
M23_SELF_COLLISION_BODY_NAMES = (
    "FL_hip",
    "FL_thigh",
    "FL_calf",
    "FL_foot",
    "RL_hip",
    "RL_thigh",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a2_piper_base_v20_R2_m22_adjudication_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adjudicator_state",
    "manifest_sha256",
    "group",
    "row_count",
    "valid_rows"
  ],
  "properties": {
    "schema": {
      "const": "a2_piper_base_v20_R2_m22_adjudication_v1"
    },
    "adjudicator_state": {
      "enum": [
        "M22_70ROW_PASS",
        "STRICT_VALID",
        "STRICT_INVALID",
        "INCONCLUSIVE"
      ]
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "group": {
      "type": "string",
      "pattern": "^G[1-7]$"
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "valid_rows": {
      "type": "integer",
      "minimum": 0
    },
    "invalid_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rows": {
      "type": "array",
      "minItems": 70,
      "maxItems": 70,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "group",
          "checkpoint_step",
          "checkpoint_sha256",
          "record_set_sha256",
          "state"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "group": {
            "type": "string",
            "pattern": "^G[1-7]$"
          },
          "checkpoint_step": {
            "type": "integer",
            "minimum": 0
          },
          "checkpoint_path": {
            "type": "string"
          },
          "checkpoint_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "config_path": {
            "type": "string"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "record_set_path": {
            "type": "string"
          },
          "record_set_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "enum": [
              "STRICT_VALID",
              "STRICT_INVALID",
              "NO_PROMOTABLE_CHECKPOINT"
            ]
          },
          "selected": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

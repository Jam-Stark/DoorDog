{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a2_piper_v20_R2_step_trace_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "run_uuid", "env_id", "episode_ordinal", "step_index", "batch_index", "stage", "curriculum_phase", "root_se2", "door_hinge_position_rad", "door_hinge_velocity_radps", "hold_valid", "bilateral", "coasting", "over_force", "send_ready", "pre_send_crossing_event", "root_crossing_event", "release_event", "root_x_rel_m", "arm_raw_action_6d", "taskspace_active", "positive_arm_tangent_mps", "positive_base_tangent_mps", "arm_tangent_share", "arc_position_error_m", "arc_orientation_error_rad", "along_handle_slip_m", "orthogonal_arc_residual_m", "reward_components_scaled", "terminal", "terminal_reason"],
  "properties": {
    "schema": {"const": "a2_piper_v20_R2_step_trace_v1"},
    "run_uuid": {"type": "string", "minLength": 1},
    "env_id": {"type": "integer", "minimum": 0},
    "episode_ordinal": {"const": 0},
    "step_index": {"type": "integer", "minimum": 0},
    "batch_index": {"type": "integer", "minimum": 0},
    "stage": {"type": "integer", "minimum": 0},
    "curriculum_phase": {"enum": ["disabled", "soft", "hard"]},
    "root_se2": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
    "door_hinge_position_rad": {"type": "number"},
    "door_hinge_velocity_radps": {"type": "number"},
    "hold_valid": {"type": "boolean"},
    "bilateral": {"type": "boolean"},
    "coasting": {"type": "boolean"},
    "over_force": {"type": "boolean"},
    "send_ready": {"type": "boolean"},
    "pre_send_crossing_event": {"type": "boolean"},
    "root_crossing_event": {"type": "boolean"},
    "release_event": {"type": "boolean"},
    "root_x_rel_m": {"type": "number"},
    "arm_raw_action_6d": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
    "taskspace_active": {"type": "boolean"},
    "positive_arm_tangent_mps": {"type": ["number", "null"]},
    "positive_base_tangent_mps": {"type": ["number", "null"]},
    "arm_tangent_share": {"type": ["number", "null"]},
    "arc_position_error_m": {"type": ["number", "null"]},
    "arc_orientation_error_rad": {"type": ["number", "null"]},
    "along_handle_slip_m": {"type": ["number", "null"]},
    "orthogonal_arc_residual_m": {"type": ["number", "null"]},
    "reward_components_scaled": {"type": "object", "additionalProperties": false, "patternProperties": {"^[A-Za-z0-9_.:-]+$": {"type": "number"}}},
    "terminal": {"type": "boolean"},
    "terminal_reason": {"type": "string", "minLength": 1}
  }
}
